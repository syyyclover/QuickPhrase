/* resource.rc —— 图标、清单、版本信息（UTF-8 保存，windres 需 -c 65001） */
#pragma code_page(65001)

#include <windows.h>
#include "src/resource.h"

/* 图标：IDI_APPICON 数值最小，资源管理器用它作程序图标 */
IDI_APPICON       ICON  "res/app.ico"
IDI_APPICON_SMALL ICON  "res/app.ico"

/* 通用控件 v6 + DPI 感知 */
1 24 "res/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "QuickPhrase"
            VALUE "FileDescription",  "口径生成器 —— 结构化文案快速生成工具"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "QuickPhrase"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "QuickPhrase.exe"
            VALUE "ProductName",      "口径生成器 QuickPhrase"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
