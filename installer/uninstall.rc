/* uninstall.rc —— 卸载程序资源 */
#pragma code_page(65001)

#include <windows.h>
#include "installer/setup_res.h"

IDI_SETUP ICON "res/setup.ico"

1 24 "installer/setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "QuickPhrase"
            VALUE "FileDescription",  "口径生成器 卸载程序"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "QuickPhrase-Uninstall"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "uninstall.exe"
            VALUE "ProductName",      "口径生成器 QuickPhrase"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
